                             CCTK_INT OUT anyerr)

USES FUNCTION EOS_Omni_cs2

void FUNCTION EOS_Omni_EpsFromPress(CCTK_INT IN eoskey,         \
			     CCTK_INT IN havetemp,        	\
			     CCTK_REAL IN rf_precision,          \
                             CCTK_INT IN npoints,        	\
			     CCTK_REAL IN ARRAY rho,     	\
			     CCTK_REAL INOUT ARRAY eps,  	\
			     CCTK_REAL INOUT ARRAY temp, 	\
			     CCTK_REAL IN ARRAY ye,      	\
			     CCTK_REAL IN ARRAY press,  	\
			     CCTK_REAL OUT ARRAY xeps,  	\
			     CCTK_INT OUT ARRAY keyerr,   	\
                             CCTK_INT OUT anyerr)

USES FUNCTION EOS_Omni_EpsFromPress


protected:

real max_press type = SCALAR "The maximum of the pressure at t=0"
real max_press_plus type = SCALAR "The maximum of the pressure at t=0 in x>0"
real max_press_minus type = SCALAR "The maximum of the pressure at t=0 in x<0"


# Defining some variables for the Simple Wave test (using GRHydro as a model)

CCTK_REAL SW_grid_functions TYPE=GF TIMELEVELS=1 tags='checkpoint="no"'
{
	simple_tmp 
	c_s 
} "1D arrays for the simple-wave routine"

CCTK_REAL SW_scalars TYPE=scalar
{
	simple_rho_0
	simple_eps_0
} "values at v=0"

CCTK_REAL SW_output TYPE=GF TIMELEVELS=1 tags='checkpoint="no"'
{
	simple_rho
	simple_eps
} "output variables for the simple-wave routine"

private:

# For measuring separations

CCTK_INT Spritz_maxima_location TYPE=SCALAR tags='checkpoint="no"'
{
  maxima_i_plus
  maxima_j_plus
  maxima_k_plus
  maxima_i_minus
  maxima_j_minus
  maxima_k_minus
} "The location (point index) of the maximum value of rho"

CCTK_INT Spritz_maxima_iteration TYPE=SCALAR "Iteration on which maximum was last set"

int Spritz_init_data_reflevel type = SCALAR tags='checkpoint="no"' "Refinement level Spritz is working on right now"

CCTK_REAL press_sign type = GF Timelevels = 3 tags='ProlongationParameter="HydroBase::prolongation_type" tensortypealias="Scalar" interpolator="matter"' "gas pressure*sign(x)"
