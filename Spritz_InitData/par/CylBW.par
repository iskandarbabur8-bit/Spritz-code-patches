 HydroBase::rho
 HydroBase::vel
 HydroBase::w_lorentz
"

CarpetIOHDF5::one_file_per_group             = "no"
CarpetIOHDF5::open_one_input_file_at_a_time  = "yes"

CarpetIOHDF5::out1D_every     = 1
CarpetIOHDF5::out1D_d         = "yes"
CarpetIOHDF5::out1D_vars      = "
