 HydroBase::eps
 HydroBase::press
 HydroBase::rho
 HydroBase::vel
 HydroBase::w_lorentz
"

CarpetIOHDF5::out2D_every                    = 1
CarpetIOHDF5::out2D_xy                       = "yes"
CarpetIOHDF5::out2D_xz                       = "yes"
CarpetIOHDF5::out2D_yz                       = "yes"
CarpetIOHDF5::out2D_xyplane_z                = 0.0
CarpetIOHDF5::out2D_vars      = "
  Spritz::Spritz_mhd_vector_var
