## mclachlan tov_static
ActiveThorns = "Time MoL"
ActiveThorns = "Coordbase CartGrid3d Boundary StaticConformal"
ActiveThorns = "SymBase ADMBase TmunuBase HydroBase InitBase ADMCoupling ADMMacros"
ActiveThorns = "IOUtil Formaline"
ActiveThorns = "SpaceMask CoordGauge Constants LocalReduce aeilocalinterp LoopControl"
ActiveThorns = "Carpet CarpetLib CarpetReduce CarpetInterp"
ActiveThorns = "CarpetIOASCII CarpetIOScalar CarpetIOHDF5 CarpetIOBasic"
ActiveThorns = "NaNChecker"
ActiveThorns = "ReflectionSymmetry"
ActiveThorns = "EOS_Omni"
ActiveThorns = "Spritz Spritz_InitData"
ActiveThorns = "GenericFD NewRad"
ActiveThorns = "TOVSolver"


# Dynamical specetimes block - NOT TO BE USED IN COWLING APPROX ####
ActiveThorns = "ML_ADMConstraints"
ActiveThorns = "ML_BSSN ML_BSSN_Helper"

ML_ADMConstraints::timelevels = 3
ADMBase::evolution_method        = "ML_BSSN"
ADMBase::lapse_evolution_method  = "ML_BSSN"
ADMBase::shift_evolution_method  = "ML_BSSN"
ADMBase::dtlapse_evolution_method= "ML_BSSN"
ADMBase::dtshift_evolution_method= "ML_BSSN"
ML_BSSN::timelevels = 3
ML_BSSN::harmonicN           = 1      # 1+log
ML_BSSN::harmonicF           = 1.0    # 1+log
ML_BSSN::evolveA             = 1
ML_BSSN::evolveB             = 0
ML_BSSN::ShiftGammaCoeff     = 0.0
ML_BSSN::AlphaDriver         = 0.0
ML_BSSN::BetaDriver          = 0.0
ML_BSSN::advectLapse         = 0
ML_BSSN::advectShift         = 0
ML_BSSN::MinimumLapse        = 1.0e-8
ML_BSSN::initial_boundary_condition = "extrapolate-gammas"
ML_BSSN::rhs_boundary_condition     = "NewRad"
ML_BSSN::ML_log_confac_bound = "none"
ML_BSSN::ML_metric_bound     = "none"
ML_BSSN::ML_Gamma_bound      = "none"
ML_BSSN::ML_trace_curv_bound = "none"
ML_BSSN::ML_curv_bound       = "none"
ML_BSSN::ML_lapse_bound      = "none"
ML_BSSN::ML_dtlapse_bound    = "none"
ML_BSSN::ML_shift_bound      = "none"
ML_BSSN::ML_dtshift_bound    = "none"
####################################################################

# GRID PARAMETERS ###################################
CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"

CoordBase::domainsize       = "minmax"
CoordBase::spacing          = "gridspacing"

CoordBase::xmin =   0.0
CoordBase::ymin =   0.0
CoordBase::zmin =   0.0
CoordBase::xmax = 40.0
CoordBase::ymax = 40.0
CoordBase::zmax = 40.0
CoordBase::dx   = 0.3125
CoordBase::dy   = 0.3125
CoordBase::dz   = 0.3125

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_lower    = 1
CoordBase::boundary_shiftout_y_lower    = 1
CoordBase::boundary_shiftout_z_lower    = 1
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0

# OCTANT SYMMETRY ########################
ReflectionSymmetry::reflection_x = "yes"
ReflectionSymmetry::reflection_y = "yes"
ReflectionSymmetry::reflection_z = "yes"
ReflectionSymmetry::avoid_origin_x = "no"
ReflectionSymmetry::avoid_origin_y = "no"
ReflectionSymmetry::avoid_origin_z = "no"
##########################################

TmunuBase::stress_energy_storage = yes
TmunuBase::stress_energy_at_RHS  = yes
TmunuBase::timelevels            =  1
TmunuBase::prolongation_type     = none

HydroBase::timelevels            = 3

ADMMacros::spatial_order = 4

ADMBase::metric_type     = "physical"

SpaceMask::use_mask      = "yes"

Cactus::terminate           = "time"
Cactus::cctk_final_time     = 2040 #10 ms

Carpet::domain_from_coordbase = "yes"
Carpet::enable_all_storage       = "no"
Carpet::use_buffer_zones         = "yes"

Carpet::poison_new_timelevels    = "no"
Carpet::check_for_poison         = "no"
Carpet::poison_value             = 0 #113

Carpet::init_3_timelevels        = "no"
##Carpet::init_each_timelevel	 = "yes"
Carpet::init_fill_timelevels     = "yes"

# system specific Carpet paramters
driver::ghost_size               = 3

# AMR? #########################################
ActiveThorns = "CarpetRegrid2"

CarpetLib::support_staggered_operators = "yes"
CarpetLib::poison_new_memory           = "yes"
CarpetLib::poison_value                = 114
Carpet::max_refinement_levels          = 2
Carpet::prolongation_order_space       = 5
Carpet::prolongation_order_time        = 2
CarpetRegrid2::regrid_every            = 0
CarpetRegrid2::num_centres             = 1
CarpetRegrid2::num_levels_1            = 2
CarpetRegrid2::radius_1[1]             = 20.0
CarpetRegrid2::snap_to_coarse          = yes
################################################

time::dtfac = 0.25
MoL::ODE_Method             = "rk4"
MoL::MoL_Intermediate_Steps = 4
MoL::MoL_Num_Scratch_Levels = 1

# check all physical variables for NaNs
NaNChecker::check_every = 1
NaNChecker::action_if_found = "abort"
NaNChecker::check_vars = "ADMBase::metric ADMBase::lapse ADMBase::shift HydroBase::rho HydroBase::eps HydroBase::press HydroBase::vel"

## Lapse Condition:  \partial_t alpha = - alpha K
## Shift Condition:  \partial_t beta^i = 0

# Hydro paramters
HydroBase::evolution_method      = "Spritz"

Spritz::flux_type                    = "HLLE" #"LxF"
Spritz::recon_method                 = "PPM" #"MINMOD"
Spritz::Spritz_stencil            = 3
Spritz::bound                     = "none"
Spritz::rho_abs_min			 = 1e-11 #1.e-10
Spritz::initial_atmosphere_factor        = 0.1
Spritz::spritz_atmo_tolerance            = 0.001
Spritz::con2prim_mhd_method          = "Noble" #"3eqs"
Spritz::Spritz_mhd_tolf		     = 1.0e-13
Spritz::Spritz_Avec_Staggered        = "yes" #"no"
Spritz::Spritz_check_divB            = "yes"

# ADD MAGNETIC FIELD TO INITIAL DATA? ########################################
#Spritz_InitData::Spritz_initial_data   = "TOVMHD"
#Spritz_InitData::Ab1                     = 2381.852946 # B_norm max ~1e16 G
#Spritz_InitData::Avec_initial           = "Modified"
#Spritz_InitData::curlA_method           = "Staggered" #"Centered"
#Spritz_InitData::press_cut              = 0.04
#Spritz_InitData::tovmhd_timelevels      = 3
##############################################################################

# init parameters
InitBase::initial_data_setup_method = "init_some_levels"

ADMBase::initial_data            = "tov"
ADMBase::initial_lapse           = "tov"
ADMBase::initial_shift           = "tov"
ADMBase::initial_dtlapse         = "zero"
ADMBase::initial_dtshift         = "zero"

# MODEL 2 of Font, Stergioulas, Kokkotas (2000) #########################
TOVSolver::TOV_Rho_Central[0] = 1.28e-3
TOVSolver::TOV_Gamma          = 2.0
TOVSolver::TOV_K              = 100.0

EOS_Omni::poly_K     = 100.0
EOS_Omni::poly_gamma = 2.0
EOS_Omni::gl_K       = 100.0
EOS_Omni::gl_gamma   = 2.0

Spritz::Spritz_eos_type          = "General"
Spritz::Spritz_eos_table         = "Ideal_Fluid"
#########################################################################

################# OUTPUT ###############################################
IOBasic::outInfo_every              = 20
IOBasic::outInfo_vars               = "HydroBase::rho ADMBase::lapse"

IO::out_dir      = $parfile

IOScalar::outScalar_every = 20
IOScalar::one_file_per_group = yes
IOScalar::outScalar_vars  = "
 HydroBase::rho
 HydroBase::press
 HydroBase::eps
 HydroBase::vel
 ADMBase::lapse
 ADMBase::metric
 ADMBase::curv
 spritz::Spritz_mhd_vector_var
 spritz::Avec_x
 spritz::Avec_y
 spritz::Avec_z
 spritz::dens
 spritz::tau
 spritz::scon
### DYNAMICAL #############
 ML_ADMConstraints::ML_Ham
 ML_ADMConstraints::ML_mom
###########################
"

IOASCII::out1D_every     = 20
IOASCII::one_file_per_group = yes
IOASCII::output_symmetry_points = no
IOASCII::out3D_ghosts           = no
IOASCII::out3D_outer_ghosts     = no
IOASCII::out1D_vars      = "
 HydroBase::rho
 HydroBase::press
 HydroBase::eps
 HydroBase::vel
 ADMBase::lapse
 ADMBase::metric
 ADMBase::curv
### DYNAMICAL #############
 ML_ADMConstraints::ML_Ham
 ML_ADMConstraints::ML_mom
###########################
"

CarpetIOHDF5::out2D_every = 200
CarpetIOHDF5::out2D_vars = "
 HydroBase::rho
 HydroBase::press
 HydroBase::eps
 HydroBase::vel
 ADMBase::lapse
 ADMBase::metric
 ADMBase::curv
 spritz::dens
 spritz::tau
 spritz::scon
 spritz::Spritz_mhd_vector_var
### DYNAMICAL #############
 ML_ADMConstraints::ML_Ham
 ML_ADMConstraints::ML_mom
###########################
"

# Termination and checkpoit stuff #############################
ActiveThorns = "TerminationTrigger"
TerminationTrigger::max_walltime = 24.0
TerminationTrigger::on_remaining_walltime = 60.0   # minutes
TerminationTrigger::termination_from_file   = yes
TerminationTrigger::create_termination_file = yes
TerminationTrigger::termination_file        = "../TERMINATE"

IOHDF5::checkpoint                         = "yes"
IOHDF5::compression_level                  = 0
IOHDF5::open_one_input_file_at_a_time      = "yes"
IOHDF5::use_checksums                      = "yes"
IOHDF5::use_grid_structure_from_checkpoint = "yes"

IOUtil::checkpoint_dir            = "../checkpoint"
IOUtil::checkpoint_every          = 10240
IOUtil::checkpoint_ID             = "no"
IOUtil::checkpoint_keep           = 2
IOUtil::checkpoint_on_terminate   = "yes"
IOUtil::abort_on_io_errors        = "yes"
IOUtil::recover                   = "autoprobe"
IOUtil::recover_dir               = "../checkpoint"
###############################################################
