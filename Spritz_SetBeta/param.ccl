# Parameter definitions for thorn Spritz_SetBeta

SHARES: HydroBase

EXTENDS KEYWORD initial_temperature
{
  "Spritz_SetBeta" :: "Set initial data from beta-equilibrated datasets."
}

EXTENDS KEYWORD initial_Y_e
{
  "Spritz_SetBeta" :: "Set initial data from beta-equilibrated datasets."
}

EXTENDS KEYWORD initial_entropy
{
  "Spritz_SetBeta" :: "Set initial data from beta-equilibrated datasets."
}

PRIVATE:

STRING beta_df_format "Beta equilibrated initial data format" STEERABLE=RECOVER
{
  "Compose" :: "format from the Compose website"
  "Lorene" :: "format for Lorene"
} "Compose"

STRING beta_datafile "Beta equilibrated initial data - Compose case: absolute path + Input file name (without extensions); Lorene case: absolute path" STEERABLE=RECOVER
{
  "" :: ""
} ""

BOOLEAN get_EoS_eps "Get specific internal energy from beta-equilibrated EoS (from eos.thermo in Compose format, automatically computed in the Lorene format - unused in the latter case)."
{
} "yes"

BOOLEAN SetPressure "Set up initial pressure, using EoS_Omni."
{
} "no"


