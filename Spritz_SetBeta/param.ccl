# USES REAL GRHydro_max_temp        AS ID_T_max
SHARES: Spritz
USES REAL Spritz_Y_e_min         AS ID_Ye_min
USES REAL Spritz_Y_e_max         AS ID_Ye_max
USES REAL Spritz_hot_atmo_temp   AS ID_T_min
USES REAL Spritz_max_temp        AS ID_T_max
USES REAL rho_abs_min
USES REAL rho_abs_eos_min
USES REAL Eos_rf_prec
