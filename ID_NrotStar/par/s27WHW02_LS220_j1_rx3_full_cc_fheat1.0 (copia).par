############################# Flesh Data ##################################
Cactus::cctk_run_title = "s27WHW02_LS220_j1_rx3_full_cc_fheat1.0"
Cactus::cctk_full_warnings         = yes
Cactus::highlight_warning_messages = no
Cactus::cctk_itlast = 10240000000

carpet::verbose = no
carpet::veryverbose = no
#carpet::min_points_per_proc = 20000

############################# Output Related ##################################
IO::out_dir              = R0000
IO::checkpoint_dir       = R0000/cp
iohdf5::out_dir          = R0000
io::recover_dir 	 = R0000/cp

IO::out_single_precision = yes

#--- checkpoint recovery
io::recover 					= 	no
iohdf5::checkpoint 				= 	yes
io::checkpoint_every 				= 	102400
io::checkpoint_keep 				= 	2
carpetiohdf5::use_reflevels_from_checkpoint 	= 	"yes"

IOBasic::outInfo_vars			=	"Carpet::physical_time_per_hour hydrobase::rho admbase::alp"

carpetioscalar::outScalar_vars		=	"
			hydrobase::rho
                        hydrobase::press
                        hydrobase::eps
                        hydrobase::vel
			admbase::lapse
                        ctgconstraints::h{out_every=1024}
                        ctgconstraints::momentum_constraint{out_every=1024}
			hydrobase::temperature
                        hydrobase::entropy
                        hydrobase::y_e
			zelmanileak::zelmani_leak_account_local
			"


carpetioascii::out1D_vars               =       "
			hydrobase::rho
                        hydrobase::press
                        hydrobase::eps
                        hydrobase::vel
                        GRHydro::scon
                        GRHydro::dens
                        GRHydro::tau
			admbase::lapse
			admbase::metric
			admbase::shift
			admbase::curv
			ctgconstraints::h{out_every=4096}
			hydrobase::temperature
        	        hydrobase::entropy
                        hydrobase::y_e
			"

carpetioascii::out0D_vars               =       "
			Carpet::physical_time_per_hour
			Carpet::timing
                        ccccglobalmodes::total_mass
                        ccccglobalmodes::center_of_mass
			zelmanianalysis::gravitational_mass
                        zelmanianalysis::baryonic_mass
                        zelmanianalysis::gravitational_mass_in1e12
                        zelmanianalysis::baryonic_mass_in1e12
                        zelmanianalysis::angular_momentum
                        zelmanianalysis::t_over_w
                        zelmanianalysis::Madm_red
                        zelmanianalysis::Jadm_z_red
                        zelmanianalysis::inner_core_global
                        hydrobase::temperature
                        hydrobase::entropy
                        hydrobase::y_e
                        zelmanishocktracker2::shockmin
                        zelmanishocktracker2::shockmax
                        zelmanishocktracker2::shockav
                        quasilocalmeasures::qlm_scalars{out_every=2048}
			"

iohdf5::out_vars	=	"
                        hydrobase::rho
			hydrobase::entropy
			hydrobase::temperature
                        hydrobase::y_e
			hydrobase::vel
			admbase::metric
			admbase::shift
			admbase::lapse
			zelmanileak::lum_local[0]
                        zelmanileak::lum_local[1]
                        zelmanileak::lum_local[2]
                        zelmanileak::heat_local[0]
                        zelmanileak::heat_local[1]
"

