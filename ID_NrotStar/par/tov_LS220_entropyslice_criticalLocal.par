# Parameter file for a static TOV star.
# Initial data are set up using LORENE-nrotstar,
# with no magnetic field and no rotation.

ActiveThorns = "Time MoL"
ActiveThorns = "Coordbase CartGrid3d Boundary StaticConformal"
ActiveThorns = "SymBase ADMBase TmunuBase HydroBase InitBase ADMCoupling ADMMacros"
ActiveThorns = "IOUtil"
ActiveThorns = "Formaline"
ActiveThorns = "SpaceMask CoordGauge Constants LocalReduce aeilocalinterp LoopControl"
ActiveThorns = "Carpet CarpetLib CarpetReduce CarpetRegrid2 CarpetInterp"
ActiveThorns = "CarpetIOASCII CarpetIOScalar CarpetIOHDF5 CarpetIOBasic"
ActiveThorns = "ID_NrotStar EOS_Omni GRHydro"

# Finalize
Cactus::terminate           = "time"
Cactus::cctk_final_time     = 200 # divide by ~203 to get ms
# Cactus::cctk_itlast        = 1024

# Termination Trigger
ActiveThorns = "TerminationTrigger"
TerminationTrigger::max_walltime = 24          # hours
TerminationTrigger::on_remaining_walltime = 30 # minutes
TerminationTrigger::check_file_every = 64
TerminationTrigger::termination_file = "TerminationTrigger.txt"
TerminationTrigger::termination_from_file   = "yes"
TerminationTrigger::create_termination_file = "yes"

# grid parameters
Carpet::domain_from_coordbase = "yes"
CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"
CoordBase::xmin = 0.0
CoordBase::ymin = 0.0
CoordBase::zmin = 0.0
CoordBase::xmax = 9.0
CoordBase::ymax = 9.0
CoordBase::zmax = 9.0
CoordBase::dx   =   0.2
CoordBase::dy   =   0.2
CoordBase::dz   =   0.2

CarpetRegrid2::regrid_every =   0
CarpetRegrid2::num_centres  =   1
CarpetRegrid2::position_x_1 = 0.0
CarpetRegrid2::position_y_1 = 0.0
CarpetRegrid2::position_z_1 = 0.0
CarpetRegrid2::num_levels_1 = 1
# CarpetRegrid2::radius_1[1]  = 8.0  #0.8
# CarpetRegrid2::radius_1[2]  = 16.0  #0.4
# CarpetRegrid2::radius_1[3]  = 8.0   #0.2
CarpetRegrid2::veryverbose = yes


CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3

#commenta questi se non metti la simmetria su x e y
CoordBase::boundary_shiftout_x_lower    = 1
CoordBase::boundary_shiftout_y_lower    = 1
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0

#e questo se non metti simmetria su z
CoordBase::boundary_shiftout_z_lower    = 1

ActiveThorns = "ReflectionSymmetry"
ReflectionSymmetry::reflection_x = "yes" ##
ReflectionSymmetry::reflection_y = "yes" ##
ReflectionSymmetry::reflection_z = "yes"
ReflectionSymmetry::avoid_origin_x = "no"
ReflectionSymmetry::avoid_origin_y = "no"
ReflectionSymmetry::avoid_origin_z = "no"

# storage and coupling
TmunuBase::stress_energy_storage = yes
TmunuBase::stress_energy_at_RHS  = yes
TmunuBase::timelevels            =  1
TmunuBase::prolongation_type     = none


HydroBase::timelevels            = 3

ADMMacros::spatial_order = 4

SpaceMask::use_mask      = yes

Carpet::enable_all_storage       = no
Carpet::use_buffer_zones         = "yes"

Carpet::poison_new_timelevels    = "yes"
Carpet::check_for_poison         = "no"

Carpet::init_3_timelevels        = no
Carpet::init_fill_timelevels     = "yes"

CarpetLib::poison_new_memory = "yes"
CarpetLib::poison_value      = 114

# system specific Carpet paramters
Carpet::max_refinement_levels    = 1
driver::ghost_size               = 3
Carpet::prolongation_order_space = 3
Carpet::prolongation_order_time  = 2

# Time integration
time::dtfac = 0.30

MoL::ODE_Method             = "rk4"
MoL::MoL_Intermediate_Steps = 4
MoL::MoL_Num_Scratch_Levels = 1

# check all physical variables for NaNs
#  This can save you computing time, so it's not a bad idea to do this
#  once in a whioe.
ActiveThorns = "NaNChecker"
NaNChecker::check_every = 32
NaNChecker::action_if_found = "terminate" #"terminate", "just warn", "abort"
NaNChecker::check_vars = "ADMBase::metric ADMBase::lapse ADMBase::shift HydroBase::rho HydroBase::eps HydroBase::press HydroBase::vel"

# Hydro paramters

# init parameters
InitBase::initial_data_setup_method = "init_some_levels"

HydroBase::initial_hydro         = "ID_NrotStar"
ADMBase::initial_data            = "ID_NrotStar"
ADMBase::initial_lapse           = "ID_NrotStar"
ADMBase::initial_shift           = "ID_NrotStar"
ADMBase::initial_dtlapse         = "ID_NrotStar"
ADMBase::initial_dtshift         = "ID_NrotStar"
HydroBase::initial_Bvec          = "ID_NrotStar"

ID_NrotStar::filename            = "/mnt/sdb3/NumRel/Lorene/Codes/Nrotstar/LS_sfhoBL_sliceent_critical/resu.d"
ID_NrotStar::beta_datafile       = "/mnt/sdb3/NumRel/EquationOfState/compOSEtables/sfhoBL_entropyslice1/eos"

# Set equation of state for evolution
GRHydro::EoS_Change				         =	"no"
EOS_Omni::nuceos_read_table = yes
EOS_Omni::do_energy_shift = yes
EOS_Omni::nuceos_table_name = "/mnt/sdb3/NumRel/EquationOfState/LS220_234r_136t_50y_analmu_20091212_SVNr26.h5"

#*********************
HydroBase::initial_temperature   = "ID_NrotStar_BetaEq"
HydroBase::initial_Y_e           = "ID_NrotStar_BetaEq"
HydroBase::initial_entropy       = "ID_NrotStar_BetaEq"
hydrobase::Y_e_evolution_method                  = "GRHydro"
hydrobase::temperature_evolution_method          = "GRHydro"
# hydrobase::entropy_evolution_method          = "GRHydro"
GRHydro::GRHydro_c2p_warnlevel 			             = 1
GRHydro::GRHydro_c2p_warn_from_reflevel		       = 2
# GRHydro::GRHydro_perc_ptol                       = 1.e-11  # Tolerance for primitive variable solve (percent)
grhydro::grhydro_eos_rf_prec                     = 1.0e-10  # Precision to which root finding should be carried out
# grhydro::grhydro_eos_hot_eps_fix                 = yes      # This locally injects heat to prevent failure.
grhydro::c2p_resort_to_bisection                 = yes # If the pressure guess is unphysical, try with bisection (slower but robust)
# GRHydro::GRHydro_MaxNumEvolvedVars               = 6
# GRHydro::GRHydro_MaxNumEvolvedVarsSlow           = 6
grhydro::grhydro_hot_atmo_temp                   = 0.01
grhydro::GRHydro_max_temp                        = 250
# grhydro::grhydro_hot_atmo_Y_e                    = 0.40
grhydro::grhydro_y_e_min                         = 0.035
grhydro::grhydro_y_e_max                         = 0.55
#*********************




################################################################################
################################################################################
# Horizon finding
################################################################################
################################################################################


GRHydro::GRHydro_enable_internal_excision	= "yes"
GRHydro::reconstruct_Wv = "yes"


ActiveThorns	= "AHFinderDirect SetMask_SphericalSurface"
SetMask_SphericalSurface::SetMask_SurfaceIndex[0] = 1
SetMask_SphericalSurface::SetMask_RadiusFactor[0] = 0.6
SphericalSurface::nsurfaces             = 6
SphericalSurface::maxntheta             = 66
SphericalSurface::maxnphi               = 124
SphericalSurface::verbose               = no

# Horizon 1
SphericalSurface::ntheta            [0] = 41
SphericalSurface::nphi              [0] = 80
SphericalSurface::nghoststheta      [0] = 2
SphericalSurface::nghostsphi        [0] = 2

# Horizon 2
SphericalSurface::ntheta            [1] = 41
SphericalSurface::nphi              [1] = 80
SphericalSurface::nghoststheta      [1] = 2
SphericalSurface::nghostsphi        [1] = 2

# Horizon 3
SphericalSurface::ntheta            [2] = 41
SphericalSurface::nphi              [2] = 80
SphericalSurface::nghoststheta      [2] = 2
SphericalSurface::nghostsphi        [2] = 2

# Horizon 4
SphericalSurface::ntheta            [3] = 41
SphericalSurface::nphi              [3] = 80
SphericalSurface::nghoststheta      [3] = 2
SphericalSurface::nghostsphi        [3] = 2

SphericalSurface::ntheta       [4] = 39
SphericalSurface::nphi         [4] = 76
SphericalSurface::nghoststheta [4] = 2
SphericalSurface::nghostsphi   [4] = 2
SphericalSurface::set_spherical[4] = yes
SphericalSurface::radius       [4] = 4.

SphericalSurface::ntheta       [5] = 39
SphericalSurface::nphi         [5] = 76
SphericalSurface::nghoststheta [5] = 2
SphericalSurface::nghostsphi   [5] = 2
SphericalSurface::set_spherical[5] = yes
SphericalSurface::radius       [5] = 6.

# AHFinderDirect relies on ADMBase to tell it how many
# timelevels it needs
admbase::metric_timelevels 				 = 3
admbase::shift_timelevels 				 = 3
admbase::lapse_timelevels 				 = 3
AHFinderDirect::N_horizons                               = 4
AHFinderDirect::find_every                               = 4
AHFinderDirect::output_h_every                           = 0
AHFinderDirect::max_Newton_iterations__initial           = 50
AHFinderDirect::max_Newton_iterations__subsequent        = 50
AHFinderDirect::max_allowable_Theta_growth_iterations    = 10
AHFinderDirect::max_allowable_Theta_nonshrink_iterations = 10
AHFinderDirect::geometry_interpolator_name               = "Lagrange polynomial interpolation"
AHFinderDirect::geometry_interpolator_pars               = "order=4"
AHFinderDirect::surface_interpolator_name                = "Lagrange polynomial interpolation"
AHFinderDirect::surface_interpolator_pars                = "order=4"
AHFinderDirect::verbose_level                            = "physics details"
AHFinderDirect::move_origins                             = no

# don't announce stuff
AHFinderDirect::which_horizon_to_announce_centroid    = 0

AHFinderDirect::run_at_CCTK_POST_RECOVER_VARIABLES = yes

# AHFinderDirect starts counting at 1
AHFinderDirect::origin_x                             [1] = 0
AHFinderDirect::find_after_individual_time           [1] = 34.5
AHFinderDirect::initial_guess__coord_sphere__x_center[1] = 0
AHFinderDirect::initial_guess__coord_sphere__radius  [1] = 1.6
AHFinderDirect::which_surface_to_store_info          [1] = 0
#AHFinderDirect::set_mask_for_individual_horizon      [1] = no
AHFinderDirect::reset_horizon_after_not_finding      [1] = no

AHFinderDirect::origin_x                             [2] = 0
AHFinderDirect::find_after_individual_time           [2] = 34.5
AHFinderDirect::initial_guess__coord_sphere__x_center[2] = 0
AHFinderDirect::initial_guess__coord_sphere__radius  [2] = 1.2
AHFinderDirect::which_surface_to_store_info          [2] = 1
#AHFinderDirect::set_mask_for_individual_horizon     [2] = no
AHFinderDirect::reset_horizon_after_not_finding      [2] = no

AHFinderDirect::origin_x                             [3] = 0
AHFinderDirect::find_after_individual_time           [3] = 34.5
AHFinderDirect::initial_guess__coord_sphere__x_center[3] = 0
AHFinderDirect::initial_guess__coord_sphere__radius  [3] = 0.8
AHFinderDirect::which_surface_to_store_info          [3] = 2
#AHFinderDirect::set_mask_for_individual_horizon      [3] = no
AHFinderDirect::reset_horizon_after_not_finding      [3] = no

AHFinderDirect::origin_x                             [4] = 0
AHFinderDirect::find_after_individual_time           [4] = 34.5
AHFinderDirect::initial_guess__coord_sphere__x_center[4] = 0
AHFinderDirect::initial_guess__coord_sphere__radius  [4] = 0.4
AHFinderDirect::which_surface_to_store_info          [4] = 3
#AHFinderDirect::set_mask_for_individual_horizon      [4] = no
AHFinderDirect::reset_horizon_after_not_finding      [4] = no
