############################################################
###
###  In order to obtain consistent results from checkpoint files
###  in recovery process, we need synchronization before creating
###  checkpoint files.
###                                  by Kentaro Apr 2013.
###
############################################################

if (     CCTK_Equals( ADMBase_evolution_method,         "static" ) || CCTK_Equals( ADMBase_evolution_method, "none" ) \
    ||   CCTK_Equals( ADMBase_lapse_evolution_method,   "static" ) \
    ||   CCTK_Equals( ADMBase_shift_evolution_method,   "static" ) \
    || ( CCTK_Equals( ADMBase_dtlapse_evolution_method, "static" ) && CCTK_IsThornActive( "ML_BSSN" ) ) \
    || ( CCTK_Equals( ADMBase_dtshift_evolution_method, "static" ) && CCTK_IsThornActive( "ML_BSSN" ) ) )
{
    schedule GROUP ADMBase_Sync IN Recovery_Sync_BeforeCheckpoint
    {
	OPTIONS: LEVEL
	SYNC: ADMBase::lapse
	SYNC: ADMBase::dtlapse
	SYNC: ADMBase::shift
	SYNC: ADMBase::dtshift
	SYNC: ADMBase::metric
	SYNC: ADMBase::curv
    } "synchronization of ADMBase variables"
}


schedule GROUP Spritz_Sync IN Recovery_Sync_BeforeCheckpoint
{
	OPTIONS: LEVEL
	SYNC: dens
	SYNC: tau
	SYNC: scon
	SYNC: HydroBase::w_lorentz
	SYNC: HydroBase::rho
	SYNC: HydroBase::press
	SYNC: HydroBase::eps
	SYNC: HydroBase::vel
  SYNC: hydrobase::Y_e
  SYNC: Y_e_con
	SYNC: Spritz_mhd_vector_var
	SYNC: Spritz_mhd_evolved_var
	SYNC: Avec_x
	SYNC: Avec_y
	SYNC: Avec_z
	SYNC: psi_mhd
} "synchronization of hydro variables"

schedule Spritz_CheckConstrainT IN CCTK_POSTSTEP AFTER Spritz_RefinementLevel
