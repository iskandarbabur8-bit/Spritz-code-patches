  LANG: C
} "Check if constraining temperature."

if(!CCTK_IsThornActive("ZelmaniLeak")) { #it is already scheduled by ZelmaniLeak.
  if(Spritz_Constrain_Temperature) {
    schedule group HydroBase_Prim2ConInitial AT CCTK_EVOL AFTER (MoL_Evolution,MoL_PseudoEvolution)
    {
    } "Do some Prim2Con on cell-centers to update conserved variable tau."
  }
}

