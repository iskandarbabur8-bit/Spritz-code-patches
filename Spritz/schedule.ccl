if (CCTK_Equals(Spritz_eos_type,"Polytype"))
{
  #When using the vector potential Con2Prim is not executed on all the ghost-points
  # and so we need to syncronize the different processors
      schedule Con2PrimPolytype_mhd IN HydroBase_Con2Prim AS Con2Prim
      {
      LANG: Fortran
      SYNC: HydroBase::w_lorentz
      SYNC: HydroBase::rho
      SYNC: HydroBase::press
      SYNC: HydroBase::eps
      SYNC: HydroBase::vel
      SYNC: hydrobase::Y_e
      SYNC: Spritz_mhd_vector_var
      SYNC: Spritz_mhd_evolved_var
      SYNC: Avec_x
      SYNC: Avec_y
      SYNC: Avec_z
      SYNC: psi_mhd
      } "Convert back to primitive variables (general, GRMHD version)"
}
else if (CCTK_Equals(Spritz_eos_type,"General"))
{
  #When using the vector potential Con2Prim is not executed on all the ghost-points
	# and so we need to syncronize the different processors
        # Syncing also tau in order to avoid issue when T is constrained
      schedule Conservative2Primitive_mhd IN HydroBase_Con2Prim AS Con2Prim
      {
      LANG: Fortran
      SYNC: HydroBase::w_lorentz
      SYNC: HydroBase::rho
      SYNC: HydroBase::press
      SYNC: HydroBase::eps
      SYNC: HydroBase::vel
      SYNC: hydrobase::Y_e
      SYNC: hydrobase::temperature
      SYNC: hydrobase::entropy
      SYNC: Spritz_mhd_vector_var
      SYNC: Spritz_mhd_evolved_var
      SYNC: Avec_x
      SYNC: Avec_y
      SYNC: Avec_z
      SYNC: psi_mhd
      SYNC: tau
      } "Convert back to primitive variables (general, GRMHD version)"
}

# Re-fix Avec_x/Avec_y's staggered equatorial-symmetry ghostzones: the
# preceding SYNC hands them back to ReflectionSymmetry's generic
# (staggering-unaware) fill, which is wrong for these z-staggered fields
# (see Spritz_set_Avec_gz_symmetries.c for why). No SYNC of its own.
schedule Spritz_set_Avec_gz_symmetries IN HydroBase_Con2Prim AFTER Con2Prim
{
  LANG: C
  READS: GRID::coordinates, Avec_x, Avec_y, Avec_z
  WRITES: Avec_x(boundary), Avec_y(boundary), Avec_z(boundary)
} "Re-apply staggered equatorial-symmetry ghostzones on Avec after Con2Prim's SYNC"

#################################################################
### Having finished all the updates, we apply the boundary    ###
### conditions and synchronize the conservative and primitive ###
### variables. All other grid functions are reset only in the ###
### interior of the grid and are totally reset at every step, ###
### and so synchronization is not necessary.                  ###
#################################################################

schedule group Do_Spritz_Boundaries IN HydroBase_Boundaries BEFORE(HydroBase_Select_Boundaries)
{
} "Spritz Boundary conditions group"

schedule Spritz_Boundaries IN HydroBase_Select_Boundaries
{
  LANG: Fortran
  OPTIONS: LEVEL
  SYNC: dens
  SYNC: tau
  SYNC: scon
  SYNC: HydroBase::w_lorentz
  SYNC: HydroBase::rho
  SYNC: HydroBase::press
  SYNC: HydroBase::eps
  SYNC: HydroBase::vel
  SYNC: hydrobase::temperature
  SYNC: hydrobase::Y_e
  SYNC: Y_e_con
  SYNC: Spritz_mhd_vector_var
  SYNC: Spritz_mhd_evolved_var
  SYNC: Avec_x
  SYNC: Avec_y
  SYNC: Avec_z
  SYNC: psi_mhd
} "Select Spritz boundary conditions"

# Re-fix again after this SYNC too, for the same reason as after Con2Prim.
schedule Spritz_set_Avec_gz_symmetries IN HydroBase_Select_Boundaries AFTER Spritz_Boundaries
{
  LANG: C
  READS: GRID::coordinates, Avec_x, Avec_y, Avec_z
  WRITES: Avec_x(boundary), Avec_y(boundary), Avec_z(boundary)
} "Re-apply staggered equatorial-symmetry ghostzones on Avec after Spritz_Boundaries' SYNC"


schedule Spritz_outer_boundaries_on_A_mu IN HydroBase_Boundaries
{
  LANG: C
} "Linear extrapolation on A_mu at outer boundaries"


schedule group HydroBase_Boundaries IN MoL_Evolution AFTER MoL_Step
{
} "HydroBase Boundary conditions group"



