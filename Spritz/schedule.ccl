#####################################################################
### Initialize the atmosphere and the conserved variables.        ###
#####################################################################

  schedule Spritz_Prim2ConInitial IN HydroBase_Prim2ConInitial
  {
    LANG: C
    SYNC: dens
    SYNC: scon
    SYNC: tau
    SYNC: press
    SYNC: HydroBase::w_lorentz
    SYNC: hydrobase::Y_e
    SYNC: Y_e_con
    SYNC: Spritz_mhd_evolved_var
  } "Setup the atmosphere and the conserved variables"


#####################################################################
### The group to calculate the update term for MoL. This contains ###
### the calculation of the source terms and the flux update.      ###
#####################################################################

schedule group SpritzRHS IN HydroBase_RHS
{
  STORAGE:Spritz_scalars
} "Calculate the update terms"

# HydroBase_RHS runs in MoL_CalcRHS, i.e. once per Runge-Kutta substep, not
# once per full timestep -- unlike the Con2Prim/Boundaries re-fixes above.
# Between substeps Carpet refreshes ghostzones (including Avec's, via the
# same staggering-unaware generic fill), so SourceTerms/FluxTerms below
# (which read Avec's z-neighbors via curl/InterpEdges2Center, see
# Spritz_HLLE_MHD.F90) would otherwise use stale/wrong-parity ghostzones on
# every substep except the first. No SYNC of its own.
schedule Spritz_set_Avec_gz_symmetries IN SpritzRHS BEFORE SourceTerms
{
  LANG: C
  READS: GRID::coordinates, Avec_x, Avec_y, Avec_z
  WRITES: Avec_x(boundary), Avec_y(boundary), Avec_z(boundary)
} "Re-apply staggered equatorial-symmetry ghostzones on Avec before every RHS substep"

####################################################################
### Do the source terms first, as this does not require the loop ###
### over the different directions                                ###
####################################################################

schedule SourceTerms IN SpritzRHS BEFORE FluxTerms
{
  LANG: Fortran
} "Source term calculation"

#################################################################
### Initial setup for the loop over the different directions. ###
#################################################################

schedule SpritzStartLoop IN SpritzRHS BEFORE FluxTerms
{
  LANG: Fortran
  OPTIONS: level
} "Set the flux_direction variable"

# this avoids poison warnings at startup, but is otherwise unnecessary
schedule SpritzStartLoop AT BASEGRID
{
  LANG: Fortran
  OPTIONS: level
} "Set the flux_direction variable"

###################################################################
### The group to calculate the update terms from the fluxes. We ###
### do this as a loop over each direction to reduce coding and  ###
### hopefully to reduce bugs. The parameter flux_direction runs ###
### from (3->0) corresponding to (z->x) and stopping. At each   ###
### step in the loop the data is reconstructed and then the     ###
### fluxes are computed by the Riemann solve.                   ###
###################################################################


schedule group FluxTerms IN SpritzRHS WHILE Spritz::flux_direction
{
  STORAGE:Spritz_prim_bext
  STORAGE:Spritz_con_bext
  STORAGE:Spritz_fluxes
  STORAGE:Spritz_mhd_bext
  STORAGE:Spritz_mhd_fluxes
  STORAGE:Spritz_fluxes_HO
 } "Calculation of intercell fluxes"

##############################################################
### This is a wrapper call to the reconstruction routines. ###
##############################################################

  if (CCTK_Equals(Spritz_eos_type,"Polytype"))
  {
    schedule ReconstructionPolytype IN FluxTerms AS Reconstruct
    {
      LANG: Fortran
    } "Reconstruct the functions at the cell boundaries"
  }
  else if (CCTK_Equals(Spritz_eos_type,"General"))
  {
    schedule Reconstruction IN FluxTerms AS Reconstruct
    {
      LANG: Fortran
    } "Reconstruct the functions at the cell boundaries"
  }


    schedule RiemannSolve IN FluxTerms AFTER Reconstruct AS Riemann
    {
      LANG: Fortran
    } "Solve the local Riemann problems"




###########################################################
### After calculating the fluxes, calculate the update. ###
###########################################################

schedule UpdateCalculation IN FluxTerms AFTER Riemann
{
  LANG: Fortran
} "Calculate the update term from the fluxes"



#################################
### Advance the loop counter. ###
#################################

schedule SpritzAdvanceLoop IN FluxTerms AFTER UpdateCalculation
{
  LANG: Fortran
  OPTIONS: level
} "Decrement the flux_direction variable"



schedule SpritzMHDCT IN SpritzRHS AFTER FluxTerms
{
LANG: Fortran
} "Constrained Transport scheme for the magnetic field fluxes"


if (Spritz_check_divB)
